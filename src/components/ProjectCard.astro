---
import type { CollectionEntry } from "astro:content";
import AreaIcon from "./AreaIcon.astro";
import { useTranslations, type Lang } from "../i18n/utils";

interface Props {
	project: CollectionEntry<"projects">;
	lang: Lang;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);

const areaLabels = {
	software: t("area.software"),
	article: t("area.article"),
	music: t("area.music"),
};

const linkMeta = {
	demo: { icon: "↗", label: t("link.demo") },
	repo: { icon: "◇", label: t("link.repo") },
	screenshots: { icon: "▧", label: t("link.screenshots") },
	article: { icon: "▤", label: t("link.article") },
	summary: { icon: "≡", label: t("link.summary") },
	video: { icon: "▶", label: t("link.video") },
	audio: { icon: "♫", label: t("link.audio") },
	score: { icon: "♬", label: t("link.score") },
};

// Link interno do artigo, respeitando o prefixo de idioma da rota
// (pt: /artigos/slug — en: /en/artigos/slug).
const articleHref = project.data.articleSlug
	? lang === "en"
		? `/en/artigos/${project.data.articleSlug}`
		: `/artigos/${project.data.articleSlug}`
	: null;

const internalArticleLink = articleHref
	? { type: "article" as const, url: articleHref }
	: null;

const allLinks = internalArticleLink
	? [internalArticleLink, ...project.data.links]
	: project.data.links;
---

<article class="card" data-area={project.data.area}>
	<div class="identity">
		<span class="area">
			<AreaIcon area={project.data.area} />
			{areaLabels[project.data.area]}
		</span>
		<h3>{project.data.title[lang]}</h3>
	</div>

	<p class="short-description">{project.data.shortDescription[lang]}</p>

	<ul class="technologies">
		{project.data.technologies.map((technology) => <li>{technology}</li>)}
	</ul>

	<nav class="links">
		{
			allLinks.map((link) => (
				<a href={link.url}>
					<span aria-hidden="true">
						{linkMeta[link.type].icon}
					</span>
					{linkMeta[link.type].label}
				</a>
			))
		}
	</nav>
</article>
