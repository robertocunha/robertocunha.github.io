---
import { SITE_URL } from '../consts';
---

<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Página não encontrada — Roberto Cunha</title>
		<meta name="robots" content="noindex" />
		<link rel="canonical" href={`${SITE_URL}/404`} />
	</head>

	<body>
		<section>
			<h1>404 — Página não encontrada</h1>
			<p>O endereço que você procura não existe (mais).</p>
			<p><a href="/">← Voltar para a página inicial</a></p>
		</section>

		<hr />

		<section lang="en">
			<h1>404 — Page not found</h1>
			<p>The address you're looking for doesn't exist (anymore).</p>
			<p><a href="/en/">← Back to the homepage</a></p>
		</section>
	</body>
</html>
